# Normalize line endings to LF on commit.
* text=auto eol=lf

# Force binary handling for media and certs.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.tar.gz binary
*.tgz    binary
*.xz     binary
*.wasm   binary
*.dylib  binary
*.so     binary
*.a      binary
*.rlib   binary
*.crt    binary
*.cer    binary
*.der    binary
*.p12    binary
*.pfx    binary
*.keystore binary

# Lockfiles — never auto-merge.
Cargo.lock          merge=ours
package-lock.json   merge=ours
flake.lock          merge=ours

# Generated files (regenerated via `just regen-proto`) — diff-only, no merge.
crates/lakko-proto/src/generated/** linguist-generated=true
