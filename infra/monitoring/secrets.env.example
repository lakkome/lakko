# /etc/lakko-monitoring/secrets.env on the monitoring VPS (mode 0600, root).
# Read by setup-monitoring.sh to render alertmanager.yml. Never commit the
# filled file.

# A bot made with @BotFather, and the chat it posts to (a private chat or a
# group with the bot in it; a group id is negative).
LAKKO_ALERT_TELEGRAM_BOT_TOKEN=123456:CHANGE-ME
LAKKO_ALERT_TELEGRAM_CHAT_ID=-1000000000000

# SMTP relay for e-mail alerts (critical prod alerts only), host:port with
# STARTTLS. Optional: leave LAKKO_ALERT_SMTP_HOST empty (or delete these
# lines) and every alert goes to Telegram only.
LAKKO_ALERT_SMTP_HOST=smtp.example.com:587
LAKKO_ALERT_SMTP_USER=alerts@example.com
LAKKO_ALERT_SMTP_PASSWORD=CHANGE-ME
LAKKO_ALERT_EMAIL_FROM=alerts@example.com
LAKKO_ALERT_EMAIL_TO=ops@lakko.me
