# Alertmanager on the monitoring VPS (ADR-0096 section 7). A TEMPLATE:
# setup-monitoring.sh fills the ${...} values from
# /etc/lakko-monitoring/secrets.env with envsubst and writes
# /etc/lakko-monitoring/alertmanager/alertmanager.yml (mode 0400, readable
# by the container user only). The rendered file holds the bot token and
# the SMTP password; it never enters the repository. Without
# LAKKO_ALERT_SMTP_HOST the lines between the "email" markers are dropped
# and every alert goes to Telegram only.
#
# Alerts go to a Telegram bot and to e-mail, never through Lakko: an outage
# of Lakko must not silence them. Critical alerts go to both, warnings to
# Telegram only; every test-stack alert goes to Telegram only. Alert text carries service names and numbers only (the
# rules in infra/prometheus/rules/ are written that way).

global:
  resolve_timeout: 5m
  # BEGIN email
  smtp_smarthost: '${LAKKO_ALERT_SMTP_HOST}'
  smtp_from: '${LAKKO_ALERT_EMAIL_FROM}'
  smtp_auth_username: '${LAKKO_ALERT_SMTP_USER}'
  smtp_auth_password: '${LAKKO_ALERT_SMTP_PASSWORD}'
  smtp_require_tls: true
  # END email

route:
  receiver: telegram
  group_by: [alertname, stack, service]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # The test stack (ADR-0096 P4): Telegram only, whatever the severity, and
    # less often. It is not production; an e-mail for it would teach the
    # reader to ignore e-mail.
    - matchers: ['stack="test"']
      receiver: telegram
      repeat_interval: 12h
    - matchers: ['severity="critical"']
      receiver: telegram_and_email
      repeat_interval: 1h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: '${LAKKO_ALERT_TELEGRAM_BOT_TOKEN}'
        chat_id: ${LAKKO_ALERT_TELEGRAM_CHAT_ID}
        send_resolved: true
  - name: telegram_and_email
    telegram_configs:
      - bot_token: '${LAKKO_ALERT_TELEGRAM_BOT_TOKEN}'
        chat_id: ${LAKKO_ALERT_TELEGRAM_CHAT_ID}
        send_resolved: true
    # BEGIN email
    email_configs:
      - to: '${LAKKO_ALERT_EMAIL_TO}'
        send_resolved: true
    # END email

inhibit_rules:
  # A service that is down also fails its probes and stops its jobs; say it
  # once.
  - source_matchers: ['alertname="LakkoServiceDown"']
    target_matchers: ['alertname=~"LakkoProbeFailing|LakkoJobStale|LakkoServiceErrorRatio"']
    equal: [stack, service]
  # A critical alert on a service hides its warnings.
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [stack, service, alertname]
