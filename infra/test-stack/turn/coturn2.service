# /etc/systemd/system/coturn2.service on the test host.

[Unit]
Description=coturn TURN Server (UDP-only for edge2.lakko.me)
After=network.target

[Service]
Type=simple
User=turnserver
Group=turnserver
ExecStart=/usr/bin/turnserver -c /etc/turnserver2.conf
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
