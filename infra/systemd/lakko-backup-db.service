# Lakko backup: database dumps (ADR-0096 P2). Started by lakko-backup-db.timer.
# The script, its configuration and the heartbeat it writes are described in
# infra/scripts/backup.sh (installed as /usr/local/bin/lakko-backup).
#
# Run once by hand:  sudo systemctl start lakko-backup-db.service
# Last run:          sudo journalctl -u lakko-backup-db -n 50

[Unit]
Description=Lakko backup (database dumps)
Documentation=https://github.com/lakkome/lakko
After=network-online.target mariadb.service
Requires=mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
# Root: the dump logs in to MariaDB over its unix socket as root.
User=root
EnvironmentFile=/etc/lakko/lakko.env
ExecStart=/usr/local/bin/lakko-backup db
Nice=10
IOSchedulingClass=idle

# --- Security hardening ----------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/lakko /var/lib/node_exporter/textfile_collector
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
