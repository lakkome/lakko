# coturn unit override for the Lakko-flavoured TURN deployment
# (Phase 3a2 / 3b3). The upstream `coturn.service` shipped by
# the Ubuntu package is fine in shape; this override pins the
# config path + adds the hardening directives the upstream unit
# does not carry by default.
#
# Install:
#   1. apt install coturn (drops upstream coturn.service).
#   2. systemctl edit --full coturn.service → paste this file's
#      contents, OR copy this file to
#      /etc/systemd/system/coturn.service.d/override.conf with
#      just the [Service] block.
#   3. systemctl daemon-reload && systemctl enable --now coturn.
#
# Operate:
#   - journalctl -u coturn -f       (live log)
#   - systemctl reload coturn       (re-reads turnserver.conf
#                                    AND TLS certs without
#                                    dropping in-flight relay
#                                    sessions)

[Unit]
Description=Lakko coturn (TURN-over-TLS for WebRTC media)
Documentation=man:turnserver(1) https://github.com/lakkome/lakko
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver

# Explicit config path — overrides Ubuntu's
# /etc/default/coturn TURNSERVER_ENABLED=1 dance.
ExecStart=/usr/bin/turnserver -c /etc/turnserver.conf --no-stdout-log

# coturn reloads its TLS files in response to USR2 (and
# re-reads the config on HUP). The Ubuntu package's wrapper
# `restart` is hard — `reload` swaps certs without dropping
# active relays.
ExecReload=/bin/kill -USR2 $MAINPID

Restart=on-failure
RestartSec=5s

# CAP_NET_BIND_SERVICE — coturn binds 443/TCP for TURN-over-TLS;
# bind-to-low-port needs the capability since we don't run as
# root. systemd's AmbientCapabilities is the cleanest way to
# grant it without setcap on the binary itself.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- Security hardening ---------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# turnserver writes the prometheus metrics file to /var/lib/coturn
# and reads TLS certs from /etc/letsencrypt — whitelist these.
ReadWritePaths=/var/lib/coturn /var/log/coturn
ReadOnlyPaths=/etc/letsencrypt /etc/turnserver.conf
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
