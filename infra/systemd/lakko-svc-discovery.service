[Unit]
Description=Lakko discovery service (username OPRF lookup)
Documentation=https://github.com/lakkome/lakko
PartOf=lakko.target
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
User=lakkome
Group=lakkome

EnvironmentFile=/etc/lakko/lakko.env
Environment=RUST_LOG=info
Environment=LAKKO_BIND=127.0.0.1:8084
# `LAKKO_DISCOVERY_DATABASE_URL` is read from /etc/lakko/lakko.env above.
# Each service has its own DB — sqlx migration tracking does not collide.

ExecStart=/usr/local/bin/lakko-svc-discovery
Restart=on-failure
RestartSec=5s

# --- Security hardening ----------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=lakko.target
