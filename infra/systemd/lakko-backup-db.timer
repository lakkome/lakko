# Schedule of lakko-backup-db.service (ADR-0096 P2).
#
# Enable:  sudo systemctl enable --now lakko-backup-db.timer
# Next run: systemctl list-timers lakko-backup-db.timer

[Unit]
Description=Lakko backup (database dumps) schedule

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
RandomizedDelaySec=15m
# A run missed while the host was down starts at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
