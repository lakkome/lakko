# Rust SFU systemd unit (ADR-0011 — supersedes the LiveKit-fork
# plan of ADR-0008).
#
# The binary is the regular workspace crate `lakko-svc-sfu`
# (`services/sfu/`), built + installed by the same `just deploy`
# flow as the other Rust services (cargo build --release --bin
# lakko-svc-sfu -> /usr/local/bin/lakko-svc-sfu). NO external
# binary, NO livekit.yaml — all configuration is env-vars from
# /etc/lakko/lakko.env (project convention).
#
# Co-located on the main VPS: the str0m SFU is light (ADR-0011
# targets <= 20 MB per active call), so for V1 it shares the box
# with the API services rather than the separate CCX22 the
# LiveKit plan assumed. nginx terminates TLS for the WebSocket
# signaling + the mTLS metrics scrape (sfu.lakko.me ->
# 127.0.0.1:7880 / :9641); the UDP media socket
# (LAKKO_SFU_MEDIA_BIND) is reached DIRECTLY on a public UDP port
# opened in the firewall (media never passes through nginx).
#
# Operate:
#   - journalctl -u lakko-sfu -f
#   - systemctl restart lakko-sfu   (drops live calls — there is
#                                    no graceful drain yet)

[Unit]
Description=Lakko Rust SFU (str0m media routing + SFrame passthrough)
Documentation=https://github.com/lakkome/lakko services/sfu/README.md
PartOf=lakko.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lakkome
Group=lakkome

# All config is env-vars (no config file). lakko.env carries:
#  - LAKKO_SFU_BIND         (default 127.0.0.1:7880 — WS signaling,
#                            behind the nginx sfu.lakko.me vhost)
#  - LAKKO_SFU_METRICS_BIND (default 127.0.0.1:9641 — Prometheus
#                            /metrics, behind nginx mTLS)
#  - LAKKO_SFU_JWKS_URL     (https://auth.lakko.me/.well-known/jwks.json
#                            — the SFU verifies call-admission JWTs
#                            against the same Ed25519 key services/auth
#                            mints from; REQUIRED, the service refuses
#                            to start without it)
#  - LAKKO_SFU_MEDIA_BIND   (e.g. 0.0.0.0:43210 — public UDP media
#                            socket; unset => signaling-only, no RTP)
#  - optional: LAKKO_SFU_JWKS_REFRESH_SECS,
#    LAKKO_SFU_HANDSHAKE_TIMEOUT_SECS, LAKKO_SFU_PEER_MSG_RATE_PER_SEC
EnvironmentFile=/etc/lakko/lakko.env

ExecStart=/usr/local/bin/lakko-svc-sfu

Restart=on-failure
RestartSec=5s

# --- Security hardening ---------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The SFU is stateless (no on-disk recording yet) and logs via
# tracing -> journald, so it needs no writable paths. /etc/lakko
# is read-only.
ReadOnlyPaths=/etc/lakko
# AF_INET / AF_INET6 for the UDP media socket + the loopback
# signaling TCP listener; AF_UNIX for journald.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# The signaling listener binds 7880 (unprivileged) and the media
# socket binds a high UDP port; neither needs a privileged-port
# capability. nginx owns 443.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=lakko.target
