# ADR-0047 §4 — GIF search + media proxy in front of GIPHY. Stateless: no
# database, no writable directory. Needs outbound HTTPS to api.giphy.com and
# *.giphy.com. LAKKO_SESSION_TOKEN_SECRET and LAKKO_GIF_GIPHY_API_KEY come from
# lakko.env; without the API key the service still starts and every /gifs
# route answers 503 (the clients hide the GIF tab).

[Unit]
Description=Lakko GIF search and media proxy
Documentation=https://github.com/lakkome/lakko
PartOf=lakko.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lakkome
Group=lakkome

EnvironmentFile=/etc/lakko/lakko.env
Environment=RUST_LOG=info
Environment=LAKKO_GIF_PROXY_BIND=127.0.0.1:8091

ExecStart=/usr/local/bin/lakko-svc-gif-proxy
Restart=on-failure
RestartSec=5s

# --- Security hardening ----------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=lakko.target
