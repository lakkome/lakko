      {
        "name": "stack",
        "label": "stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up, stack)",
        "query": {
          "query": "label_values(up, stack)",
          "refId": "StandardVariableQuery",
          "qryType": 1
        },
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
