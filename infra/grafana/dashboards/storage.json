        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_size_bytes{stack=\"$stack\",fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{host}} {{mountpoint}} size",
