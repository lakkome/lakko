          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - node_filesystem_avail_bytes{stack=\"$stack\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{stack=\"$stack\",fstype!~\"tmpfs|overlay|squashfs\"}",
