            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Every non-tmpfs mount on both hosts; /var/lib/lakko (blobs, MariaDB) lives on whichever mount holds it.",
