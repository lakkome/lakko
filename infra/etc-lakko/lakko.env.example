# Template for /etc/lakko/lakko.env on the VPS. The real file is created by hand:
#
#   sudo mkdir -p /etc/lakko
#   sudo cp infra/etc-lakko/lakko.env.example /etc/lakko/lakko.env
#   sudo nano /etc/lakko/lakko.env  # fill in the values
#   sudo chown root:lakkome /etc/lakko/lakko.env
#   sudo chmod 640 /etc/lakko/lakko.env
#
# Passwords — `openssl rand -hex 32`.

# ---- MariaDB connection ----------------------------------------------------
# Each service has its OWN database — sqlx tracks applied migrations in a
# hardcoded `_sqlx_migrations` table per database, so two services on the
# same DB would see each other's migrations as "missing" and fail to start.
#
# Create the per-service databases once on the VPS (uses MariaDB root):
#
#   sudo mariadb <<'SQL'
#     CREATE DATABASE lakko_auth
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE lakko_ds
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE lakko_discovery
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE lakko_push_gw
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE lakko_channels
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE lakko_transparency
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL ON lakko_auth.*         TO 'lakko'@'localhost';
#     GRANT ALL ON lakko_ds.*           TO 'lakko'@'localhost';
#     GRANT ALL ON lakko_discovery.*    TO 'lakko'@'localhost';
#     GRANT ALL ON lakko_push_gw.*      TO 'lakko'@'localhost';
#     GRANT ALL ON lakko_channels.*     TO 'lakko'@'localhost';
#     GRANT ALL ON lakko_transparency.* TO 'lakko'@'localhost';
#     FLUSH PRIVILEGES;
#   SQL
#
# DSNs read by each service (sqlx-style). The same password is reused
# because the DB user has GRANT ALL only on its own database.
LAKKO_AUTH_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_auth
LAKKO_DS_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_ds
LAKKO_DISCOVERY_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_discovery
LAKKO_PUSH_GW_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_push_gw
LAKKO_CHANNELS_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_channels
LAKKO_TRANSPARENCY_DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko_transparency

# ---- Transparency log append (KT-log S2) -----------------------------------
# The transparency service gates POST /transparency/append on a shared
# service secret (NOT a user bearer). The discovery service holds the SAME
# secret and POSTs a leaf on every identity-key CHANGE (best-effort,
# fail-open). Base64, >= 16 bytes after decode — `openssl rand -base64 32`.
# Both services read LAKKO_TRANSPARENCY_APPEND_SECRET; discovery also needs
# LAKKO_TRANSPARENCY_URL to know where to POST. Unset the URL on discovery
# to turn the append integration off; unset the secret on transparency to
# disable the append endpoint (it then serves 503).
LAKKO_TRANSPARENCY_APPEND_SECRET=CHANGE-ME-base64-32-bytes
LAKKO_TRANSPARENCY_URL=http://127.0.0.1:8087
# KT-log S2.5 — the discovery reconciliation-sweep interval (seconds, default
# 300). The reconciler eventually appends every account's CURRENT published
# identity to the transparency log, closing the S2 best-effort fail-open gap.
# Spawned ONLY when LAKKO_TRANSPARENCY_URL is set; 0 disables the sweep.
LAKKO_DISCOVERY_TRANSPARENCY_RECONCILE_SECS=300

# ---- Group wakes: DS -> push-gw internal forward (ADR-0054) -----------------
# A signed group publish that carries `x-lakko-wake` makes the DS forward the
# wake to push-gw's INTERNAL listener (127.0.0.1:8092, set in the push-gw
# unit; never proxied by nginx), authenticated by a shared secret. Both
# secret variables MUST hold the SAME value — base64, >= 16 bytes after
# decode: `openssl rand -base64 32`.
#   * push-gw: secret unset => the internal listener is not started and no
#     group wake is delivered (loud startup warning).
#   * DS: URL and secret both unset => wakes are dropped (startup warning);
#     exactly one of the two set => the DS refuses to start.
LAKKO_PUSH_GW_INTERNAL_SECRET=CHANGE-ME-base64-32-bytes
LAKKO_DS_PUSH_GW_SECRET=CHANGE-ME-base64-32-bytes
LAKKO_DS_PUSH_GW_URL=http://127.0.0.1:8092
# Wake cap per journal and per woken push_gid (token bucket). Defaults are
# chosen, not measured: burst 30, 60 per minute. Over the cap the message is
# stored and answered normally; only the wake is dropped.
# LAKKO_DS_WAKE_BURST=30
# LAKKO_DS_WAKE_PER_MINUTE=60

# ---- Anonymous tokens (ADR-0054 decision 2) ---------------------------------
# Master secret of the anonymous rate-limit tokens: services/auth issues
# tokens under keys derived from it, and every service that accepts tokens
# holds the SAME value to verify them. 64 hex characters (32 bytes):
# `openssl rand -hex 32`. Unset => token issuance is off (/auth/tokens
# answers 503, loud startup warning). Malformed => the service refuses to
# start. Rotating it invalidates every outstanding token.
LAKKO_ANON_TOKEN_MASTER_SECRET=CHANGE-ME-64-hex-chars

# ---- Discovery rate limiting -----------------------------------------------
# Token buckets on the OPRF / username-lookup / channel-name-lookup endpoints.
# Defense in depth on top of the existing PoW gate. All values must be
# positive; the defaults are chosen, not measured.
#
# Requests WITHOUT a valid session token (signup, a fresh install): per source
# IP. Default 60 req/min sustained, burst 10.
#LAKKO_DISCOVERY_RATE_LIMIT_PER_MINUTE=60
#LAKKO_DISCOVERY_RATE_LIMIT_BURST=10
# Requests WITH a valid session token: per account (so people behind one
# router or carrier NAT do not share a bucket) ...
#LAKKO_DISCOVERY_ACCOUNT_RATE_LIMIT_PER_MINUTE=60
#LAKKO_DISCOVERY_ACCOUNT_RATE_LIMIT_BURST=10
# ... and a per-IP ceiling, so one address cycling through many accounts is
# still capped.
#LAKKO_DISCOVERY_AUTHENTICATED_IP_RATE_LIMIT_PER_MINUTE=600
#LAKKO_DISCOVERY_AUTHENTICATED_IP_RATE_LIMIT_BURST=100
# The source IP is taken from X-Real-IP (set by nginx), else the rightmost
# X-Forwarded-For entry — never a value the client supplied.

# ---- Channels retention ----------------------------------------------------
# Post retention in seconds — anything older than now-retention is pruned
# by the background loop in services/channels. Default is 30 days
# (2592000); set to 0 to disable retention entirely while keeping the
# loop running (logs every tick as no-op). Subscribers offline longer
# than this miss pre-retention posts but keep their cursor for
# everything since.
#LAKKO_CHANNELS_RETENTION_SECS=2592000
# Subscriber retention in seconds — subscribers who haven't pulled
# their envelope endpoint in this long are GC'd by the same background
# loop (FK cascade cleans up their envelope row). Default is 90 days
# (7776000); 0 disables.
#LAKKO_CHANNELS_SUBSCRIBER_RETENTION_SECS=7776000
# How often the prune loop ticks. Default is 1 hour (3600); set to 0 to
# disable the background task entirely (useful for tests that drive
# prune manually).
#LAKKO_CHANNELS_PRUNE_INTERVAL_SECS=3600

# ---- SFU (Rust str0m SFU, ADR-0011) ----------------------------------------
# The multi-party group-call SFU (`lakko-svc-sfu`). All env-var
# configured — no config file. Co-located on the main VPS; nginx fronts
# the WS signaling + mTLS metrics on sfu.lakko.me, the media plane is a
# direct public UDP port.
#
# WebSocket signaling bind (behind the nginx sfu.lakko.me vhost).
#LAKKO_SFU_BIND=127.0.0.1:7880
# Prometheus /metrics bind (behind nginx mTLS). Separate from the
# signaling bind so a public /metrics probe never reaches it.
#LAKKO_SFU_METRICS_BIND=127.0.0.1:9641
# JWKS endpoint the SFU verifies call-admission JWTs against — the same
# Ed25519 key services/auth mints from. REQUIRED: the service refuses to
# start if unset/empty.
LAKKO_SFU_JWKS_URL=https://auth.lakko.me/.well-known/jwks.json
# Public UDP media socket (str0m RTP). Must match the firewall port
# opened by deploy-sfu.sh (MEDIA_UDP_PORT). Unset => signaling-only
# (no media routing — useful for a signaling-only smoke test).
LAKKO_SFU_MEDIA_BIND=0.0.0.0:43210
# The IP the SFU advertises as its ICE host candidate in every SDP
# answer (bare IP, no port — the port comes from LAKKO_SFU_MEDIA_BIND).
# Set it to the VPS's PUBLIC IP. REQUIRED whenever LAKKO_SFU_MEDIA_BIND
# binds an unspecified address (0.0.0.0 / [::]): the service refuses to
# start without it, because "0.0.0.0" is not an address a client can
# dial and no media could ever connect. Optional with a concrete bind IP
# (defaults to that IP). Must be the same address family as the bind,
# and not unspecified / multicast / broadcast / link-local. The
# placeholder below is deliberately not an IP, so an uncustomised copy
# fails startup loudly instead of advertising a wrong address.
LAKKO_SFU_MEDIA_ADVERTISE_IP=CHANGE-ME-public-ip
# Optional tunables.
#LAKKO_SFU_JWKS_REFRESH_SECS=300
#LAKKO_SFU_HANDSHAKE_TIMEOUT_SECS=30
#LAKKO_SFU_PEER_MSG_RATE_PER_SEC=50
# Signaling-socket liveness: a WebSocket protocol ping to every peer each
# PING_SECS, and a peer that has sent nothing at all (a pong counts) for
# IDLE_SECS is dropped and announced as left. IDLE must exceed PING.
#LAKKO_SFU_SIGNALING_PING_SECS=20
#LAKKO_SFU_SIGNALING_IDLE_SECS=60

# ---- GIF proxy (ADR-0047 §4, services/gif-proxy) ---------------------------
# GIPHY API key for GIF search. Leave unset or empty to run the service
# without a provider: every /gifs route then answers 503
# {"error":"gif-provider-not-configured"} and the clients hide the GIF tab.
# The service also needs LAKKO_SESSION_TOKEN_SECRET (the same value as
# services/auth). Listen address is set in the systemd unit (127.0.0.1:8091).
LAKKO_GIF_GIPHY_API_KEY=CHANGE-ME-giphy-api-key
# Per-account limits. Search and trending share one bucket; media (preview
# and full-size fetches) has its own. Defaults below are chosen, not measured.
#LAKKO_GIF_SEARCH_RATE_PER_MINUTE=30
#LAKKO_GIF_SEARCH_BURST=10
#LAKKO_GIF_MEDIA_RATE_PER_MINUTE=600
#LAKKO_GIF_MEDIA_BURST=120

# ---- Domains ---------------------------------------------------------------
LAKKO_DOMAIN=lakko.me
LAKKO_API_DOMAIN=api.lakko.me

# ---- Logging ---------------------------------------------------------------
# RUST_LOG is read by each service; per-service level overrides go here too.
RUST_LOG=info,lakko_mls=debug,sqlx=warn

# ---- Push (filled in Phase 1.6 / sprint push-gw) ---------------------------
# These variables are only hints; real paths live in the systemd units.
# APNS_KEY_PATH=/etc/lakko/secrets/apns_key.p8
# FCM_SERVICE_ACCOUNT=/etc/lakko/secrets/fcm_sa.json
# VAPID_PRIVATE_KEY=/etc/lakko/secrets/vapid_priv.pem
