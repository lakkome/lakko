# Шаблон для /etc/lakko/lakko.env на VPS. Реальный файл создаётся вручную:
#
#   sudo mkdir -p /etc/lakko
#   sudo cp infra/etc-lakko/lakko.env.example /etc/lakko/lakko.env
#   sudo nano /etc/lakko/lakko.env  # заполнить
#   sudo chown root:lakkome /etc/lakko/lakko.env
#   sudo chmod 640 /etc/lakko/lakko.env
#
# Пароли — `openssl rand -hex 32`.

# ---- MariaDB connection ----------------------------------------------------
# DSN, который читают auth/ds/discovery services (sqlx-style).
DATABASE_URL=mysql://lakko:CHANGE-ME@127.0.0.1:3306/lakko

# ---- Domains ---------------------------------------------------------------
LAKKO_DOMAIN=lakko.me
LAKKO_API_DOMAIN=api.lakko.me

# ---- Logging ---------------------------------------------------------------
# RUST_LOG читается каждым service-ом; per-service level overrides — здесь же.
RUST_LOG=info,lakko_mls=debug,sqlx=warn

# ---- Push (заполняется в Phase 1.6 / sprint push-gw) -----------------------
# Эти переменные служат только подсказкой; реальные пути — в systemd unit-ах.
# APNS_KEY_PATH=/etc/lakko/secrets/apns_key.p8
# FCM_SERVICE_ACCOUNT=/etc/lakko/secrets/fcm_sa.json
# VAPID_PRIVATE_KEY=/etc/lakko/secrets/vapid_priv.pem
