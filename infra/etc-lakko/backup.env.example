#
# Template for /etc/lakko/backup.env (root:root, mode 600), read by
# infra/scripts/backup.sh and restore-check.sh. Set up with
# `just backup-setup` (infra/README.md "Backup / restore").

# The restic repository. A Hetzner Storage Box over sftp: the host alias
# is defined in /root/.ssh/config (Port 23, the key restic uses).
RESTIC_REPOSITORY=sftp:storagebox:lakko-restic

# The repository password, one line, root-only. Keep a copy OFF the
# server: it is the only key to every backup and is not in the backups.
RESTIC_PASSWORD_FILE=/etc/lakko/backup-password

# Optional overrides (defaults shown).
#LAKKO_BACKUP_STAGE=/var/backups/lakko
#LAKKO_BACKUP_BLOB_DIR=/var/lib/lakko
#LAKKO_BACKUP_EXTRA_PATHS="/etc/lakko /etc/letsencrypt /etc/nginx/sites-available"
#LAKKO_BACKUP_DB_PATTERN=lakko_%
#LAKKO_BACKUP_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 3"
