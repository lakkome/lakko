<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later
  SPDX-FileCopyrightText: 2026 Lakko Contributors

  Phase 1.20c2 — entitlements for the
  `LakkoNotificationService` extension.

  The single entitlement here is the App Group shared with
  the host app `Lakko` (declared in `apps/ios/project.yml`'s
  main-target entitlements with the matching identifier).
  Both targets MUST carry the App Group entry for the
  shared-container plumbing to actually work.

  In 1.20c2 the extension does NOT read any shared state —
  the threadIdentifier mutation needs only the APNs userInfo
  dictionary. The App Group is provisioned now so the App
  Store / signing infrastructure is set up once; 1.20c2b
  will wire the actual MLS state mirror through this same
  group.

  xcodegen also auto-generates an equivalent
  .entitlements file from project.yml's `properties` block,
  but committing the file explicitly here gives the
  reproducible-build pipeline a stable input + lets a
  reviewer see the entitlement contract in plain XML
  without rendering the YAML.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.me.lakko.dev.shared</string>
    </array>
    <!--
      ADR-0041 Phase 1 — matching shared Keychain access group so the
      NSE can READ the app's migrated Keychain items (seed + snapshot /
      cursor wrap keys). Team-scoped (first-party only). The NSE's own
      app-identifier group is listed first to keep its default access
      group unchanged; the NSE is read-only for these stores. The actual
      decrypt wiring is Phase 3 — this just provisions the read path.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)me.lakko.dev.LakkoNotificationService</string>
        <string>$(AppIdentifierPrefix)me.lakko.dev.shared</string>
    </array>
</dict>
</plist>
