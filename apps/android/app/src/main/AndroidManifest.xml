  Phase 1.15c — minimal manifest for the Hello-core smoke build.
  No permissions, no broadcast receivers, no services. The
  single MainActivity is the launcher entry point + the only
  visible UI. `android:exported="true"` is required for any
  activity targeting API 31+ with a LAUNCHER intent filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.Lakko">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
