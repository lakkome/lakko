<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later
  SPDX-FileCopyrightText: 2026 Lakko Contributors

  Phase 1.15c — minimal manifest for the Hello-core smoke build.
  No permissions, no broadcast receivers, no services. The
  single MainActivity is the launcher entry point + the only
  visible UI. `android:exported="true"` is required for any
  activity targeting API 31+ with a LAUNCHER intent filter.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Runtime permission for posting notifications. Required on
      Android 13+ (API 33); on lower API levels the OS
      auto-grants and the explicit request is a no-op.

      The prompt is raised from `SessionRoot` in MainActivity,
      the moment a session lands — the same moment the app
      subscribes to push, and in context: the person has just
      signed in and this is how they will hear from anyone. Not
      at app launch, where there is nothing to notify about yet.

      This comment used to name `PushSubscriber.subscribe` as
      the place the prompt came from, which was never true of
      any code: nothing in this app requested the permission at
      all until 2026-09-23, so on every Android 13+ phone it
      stayed denied and a backgrounded call never rang. The
      subscriber cannot be that place — it runs on an
      application scope with no Activity to show a dialog from,
      which is why the step its iOS twin has was missing here.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Phase 1.20d — INTERNET is implicit since API 23 (it's
      auto-granted) but the lint expects it explicit for any
      app using OkHttp / Ktor / Firebase.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Phase 2a3b4 — runtime camera permission for the add-device
      QR scanner. Compose's `DevicesScreen` requests this at the
      moment the user taps "Open camera" (mirror of iOS
      NSCameraUsageDescription Just-In-Time prompt). Without the
      permission the screen surfaces a "permission needed"
      affordance with a deep-link to Settings.

      `<uses-feature>` advertises camera as optional — Lakko
      runs fine on devices without a back-camera (the user can
      still receive a pairing from the other side; only the
      add-device path needs it).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      G3-2 — WebRTC pod runtime permissions for the in-call
      audio capture path. `RECORD_AUDIO` is the runtime
      permission the OS gates `AudioRecord` (and therefore
      `org.webrtc.AudioSource`) on; `MODIFY_AUDIO_SETTINGS`
      is required by `AudioManager.setMode(MODE_IN_COMMUNICATION)`
      which WebRTC uses to switch the audio routing into
      voice-call mode (echo-cancellation, AGC, NS all flip
      to the in-call profile). Both are install-time on
      pre-23 / runtime on 23+; CallScreen requests them
      just-in-time on the user's first dial / accept.

      `<uses-feature>` for the microphone is `false` —
      Lakko runs fine on devices without a mic (text-only
      messaging). Only a user trying to start a call hits
      the permission prompt.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      docs/ux/calls.md section 2.1 — an incoming call takes the whole
      screen, over the lock screen. `USE_FULL_SCREEN_INTENT` is what
      lets the call notification launch
      `me.lakko.app.ui.call.IncomingCallActivity` instead of merely
      showing a heads-up. It is install-time (auto-granted) for an app
      whose notification is `CATEGORY_CALL`, which ours is; on Android
      14+ the platform additionally restricts the permission to calling
      and alarm apps, and a call notification qualifies. When the grant
      is absent the notification still rings and still carries Accept
      and Decline — the user just taps it rather than being taken
      straight to the call screen, so there is no silent failure.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- An incoming call vibrates. While the app is in the foreground it rings
         itself rather than through the call notification (the platform turns a
         full-screen intent into a heads-up on an unlocked phone, which covers
         the app's own incoming-call screen), so the vibration the channel
         would have carried has to come from here. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- "Show recovery phrase" (Settings > Security > Recovery) asks the
         device to authenticate its owner first: fingerprint, face or the
         screen lock, through the system prompt. A normal permission; the
         app never sees biometric data. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.Lakko"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Phase 1.15e11a — deep-link handler for invite URLs.
              The OS routes `https://lakko.me/i/<slug>` taps from
              any app (Messages, email, browser) into MainActivity.
              The Activity reads `intent.data` on launch / via
              `onNewIntent`, extracts the slug, hands it to
              `InviteIntake.publish(...)` so the Compose router can
              navigate to the [InviteLandingScreen].

              `autoVerify="true"` opts into Android App Links —
              the OS fetches `https://lakko.me/.well-known/assetlinks.json`
              to verify the app's SHA-256 cert fingerprint owns
              the domain, then opens our app directly **without**
              showing the disambiguation chooser. The assetlinks
              file ships on the discovery service in a later
              sprint; until then this filter still works but the
              user sees the standard "open with…" picker.

              The intent filter matches BOTH https + http so a
              user in a censored region using a self-hosted
              `lakko.me` mirror over plaintext still lands here.
              The capability codec itself doesn't depend on TLS
              for security — the bytes are Ed25519-signed.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="lakko.me" />
                <!--
                  The test stack. A link a phone taps must open the installed
                  app, so the app claims every host a build can mint links
                  under; each host is verified on its own against the
                  `/.well-known/assetlinks.json` it serves (the web client
                  ships the file), and one host failing verification does not
                  take the others down.
                -->
                <data android:host="test.lakko.me" />
                <data android:pathPrefix="/i/" />
                <!-- ADR-0028 (G-3) — group join-ticket deep links. -->
                <data android:pathPrefix="/g/" />
                <!-- ADR-0032 (G-21/G-22) — multi-joiner call-invite links. -->
                <data android:pathPrefix="/c/" />
                <!-- ADR-0063 — a shared feed; the rule rides in the fragment. -->
                <data android:pathPrefix="/feed/import" />
            </intent-filter>

            <!--
              docs/ux/feed.md section 5 — a shared feed file opened from
              another app ("Open with" in Files, mail, a messenger). Most
              senders give a `.lakkofeed` file the generic binary type, so
              that type is claimed along with Lakko's own; whether the bytes
              are a feed is the core's to say on the import screen, which
              refuses anything else whole ("This file isn't a feed Lakko can
              open.").
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.lakko.feed" />
            </intent-filter>
            <!-- By name, for senders whose URI still carries it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.lakkofeed" />
                <data android:pathPattern=".*\\..*\\.lakkofeed" />
                <data android:pathPattern=".*\\..*\\..*\\.lakkofeed" />
            </intent-filter>
            <!-- Shared to Lakko from another app's share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.lakko.feed" />
            </intent-filter>
        </activity>

        <!--
          docs/ux/calls.md section 2.2 — the incoming call screen, raised
          by the call notification's full-screen intent.

          `showWhenLocked` + `turnScreenOn` are what make a call reach a
          locked phone: the window draws over the keyguard and wakes the
          screen, so the call can be answered without unlocking (the
          Activity sets both in code as well, for the pre-API-27 window
          flags and because some OEM builds need the runtime call).

          `excludeFromRecents` + an empty `taskAffinity` keep the ring in
          its own task: a declined call must leave nothing behind in the
          recents list, and answering starts MainActivity in the app's own
          task rather than stacking the app under a ring screen.

          `exported="false"` — only this app's own notification and its
          own ringer ever launch it.
        -->
        <activity
            android:name=".ui.call.IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lakko" />

        <!--
          `Decline` from the call notification. A receiver, not an
          activity: refusing a call must not open the app.
        -->
        <receiver
            android:name=".calls.IncomingCallActionReceiver"
            android:exported="false" />

        <!--
          Phase 1.20d — FirebaseMessagingService subclass that
          receives FCM wake payloads. Firebase auto-discovers
          this via the intent filter; the OS routes
          `com.google.firebase.MESSAGING_EVENT` broadcasts to
          this service in the background and lights up the
          process (via the Firebase Messaging SDK's wakelock)
          long enough for `onMessageReceived` / `onNewToken` to
          run.

          `android:exported="false"` is canonical for an FMS
          subclass — only the FCM SDK itself ever invokes it.
        -->
        <service
            android:name=".push.LakkoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
