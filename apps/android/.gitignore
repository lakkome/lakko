# Gradle build outputs
.gradle/
build/
**/build/

# Local SDK / IDE config — picks up the dev's machine-specific
# Android SDK path; never committed.
local.properties

# IDE configs (Android Studio + IntelliJ family)
.idea/
*.iml

# Per-build native libs are regenerated via `just build-android`
# — `cargo ndk` drops them under lakko-core/src/main/jniLibs/{abi}/
# and a clean tree never carries them.
lakko-core/src/main/jniLibs/

# Generated Kotlin bindings live under
# lakko-core/src/main/kotlin/uniffi/ — they're produced by
# `just regen-bindings` and tracked separately so dev builds
# don't bake a stale copy. Excluding the whole `uniffi/`
# subtree keeps the cargo-generated names out of git too.
lakko-core/src/main/kotlin/uniffi/

# Keystore / signing — never committed in any form.
*.jks
*.keystore
