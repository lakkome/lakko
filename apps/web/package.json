{
  "//": [
    "SPDX-License-Identifier: AGPL-3.0-or-later",
    "SPDX-FileCopyrightText: 2026 Lakko Contributors"
  ],

  "name": "@lakko/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Lakko web client — Solid.js + WASM core (Phase 1.16a skeleton)",

  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/lakko-ffi-wasm --target web --out-dir ../../apps/web/wasm --release",
    "build:wasm:dev": "wasm-pack build ../../crates/lakko-ffi-wasm --target web --out-dir ../../apps/web/wasm --dev",
    "dev": "npm run build:wasm:dev && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf wasm dist node_modules/.vite"
  },

  "dependencies": {
    "@solidjs/router": "^0.16.0",
    "solid-js": "^1.9.0"
  },

  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vite-plugin-wasm": "^3.4.0"
  }
}
