{
  "name": "Lakko",
  "short_name": "Lakko",
  "description": "Private messaging. End-to-end encrypted by default.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#3730a3",
  "lang": "en",
  "dir": "ltr",
  "file_handlers": [
    {
      "action": "/feed/import",
      "accept": {
        "application/vnd.lakko.feed": [".lakkofeed"]
      }
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
