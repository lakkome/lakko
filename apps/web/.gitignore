# Node / Vite artifacts
node_modules/
dist/
.vite/

# wasm-pack output — regenerated by `npm run build:wasm`. We do
# not commit the .wasm blob or the wasm-bindgen JS shim; CI rebuilds
# them from `crates/lakko-ffi-wasm`.
wasm/

# Playwright: run output, and the audio fixtures `globalSetup` generates.
# The fixtures are binary and reproducible from `playwright/fixtures/make-assets.mjs`,
# so they are built rather than committed.
test-results/
playwright-report/
playwright/.cache/
playwright/fixtures/*.wav
playwright/fixtures/*.m4a

# Editor / OS
.DS_Store
*.log
