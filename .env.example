# Workspace-level dev environment.
#
# Copy to `.env` (gitignored):
#   cp .env.example .env
#
# `.env` is loaded:
#   - via `dotenvy::dotenv()` from each service main() in debug builds
#   - RustRover Run Configurations in .run/*.run.xml reference the same
#     keys and pick `.env` up via the EnvFile plugin (if installed) or
#     duplicate the values inline in the Run Config
#
# In production these values are **NOT** used — systemd loads
# /etc/lakko/lakko.env via `EnvironmentFile=` in the service unit files.

# ---- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn,lakko_svc_auth=debug,lakko_svc_ds=debug,lakko_mls=debug

# ---- Database (local docker MariaDB) --------------------------------------
# Each service uses its OWN database. sqlx tracks applied migrations in a
# hardcoded `_sqlx_migrations` table per database, so two services sharing a
# database would see each other's migrations as "missing" and refuse to
# start. One database = one service.
#
# Local docker MariaDB: container `mariadb`, user `lakko/devpass`.
# Create the per-service databases once with the root password (see
# `docker inspect mariadb` for MARIADB_ROOT_PASSWORD):
#
#   docker exec -i mariadb mariadb -u root -p<root_pw> <<'SQL'
#     CREATE DATABASE IF NOT EXISTS lakko_auth
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_ds
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_discovery
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_push_gw
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL ON lakko_auth.*      TO 'lakko'@'%';
#     GRANT ALL ON lakko_ds.*        TO 'lakko'@'%';
#     GRANT ALL ON lakko_discovery.* TO 'lakko'@'%';
#     GRANT ALL ON lakko_push_gw.*   TO 'lakko'@'%';
#     FLUSH PRIVILEGES;
#   SQL
#
# Each service first reads its dedicated `LAKKO_<NAME>_DATABASE_URL`; if
# unset it falls back to the generic `DATABASE_URL`. The fallback is for
# convenience while running a single service in isolation — in production
# each systemd unit pins its own DB.
LAKKO_AUTH_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_auth
LAKKO_DS_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_ds
LAKKO_DISCOVERY_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_discovery
LAKKO_TRANSPARENCY_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_transparency
LAKKO_PUSH_GW_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_push_gw
# ADR-0017 (ii) — per-account cool-down (seconds) on UNPROVEN AccountIdentity
# changes to a NEW key (the lost-everything publish), blunting attacker churn.
# Default 3600 (1 h); 0 disables. Heal-back + proven rotations are never gated.
LAKKO_DISCOVERY_FRESH_IDENTITY_COOLDOWN_SECS=3600

# Generic fallback (not used if the per-service var above is set).
DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_auth

# ---- Service binds (optional — each service has its own default) ----------
# Uncomment to override the listen address.
# LAKKO_BIND=127.0.0.1:8081

# ---- Session tokens (Phase 1.5b) ------------------------------------------
# Shared HMAC-SHA256 secret loaded by BOTH `services/auth` (issues tokens
# on every */finish endpoint) AND `services/discovery` (verifies them on
# every protected write via auth::require_session middleware). The value
# below is a development placeholder — `openssl rand -base64 48` for a
# production secret, drop into /etc/lakko/lakko.env, deploy both services
# together.
LAKKO_SESSION_TOKEN_SECRET=ZGV2LXNlc3Npb24tdG9rZW4tc2VjcmV0LWZvci1sb2NhbC10ZXN0aW5nLW9ubHkhIQ==
# Optional (ADR-0073): access-token TTL in seconds (default 900). It is the
# revocation latency at every verifier but auth after a key reset, and how
# often a foreground client refreshes; a first value to measure, not a result.
# LAKKO_SESSION_TOKEN_TTL_SECS=900

# ADR-0073: auth attestation verifying key (standard base64, 32 bytes) for
# discovery to verify key-reset attestations; unset => that arm answers 503.
# Taken from auth's /.well-known/device-attest-jwks.json. (The DS needed it
# too until ADR-0078 phase 6 removed its attested reset.)
# LAKKO_DISCOVERY_ATTEST_KEY=
# Optional (ADR-0080): the DB-IP City Lite database (MaxMind format) behind
# GET /discovery/locate. Unset: the route answers {}.
# LAKKO_DISCOVERY_CITY_DB=
# Optional (ADR-0073): refresh-credential TTL in days (default 30); accepted
# by auth's POST /auth/session/refresh only, slides on every refresh.
# LAKKO_REFRESH_TOKEN_TTL_DAYS=30
# Optional (ADR-0074): POST /account/devices/revoke per signed-in account,
# N/SECS (default 20/3600; chosen, not measured). Charged only after the
# fresh-auth grant and the account-key statement were accepted.
# LAKKO_AUTH_LIMIT_DEVICE_REVOKE=20/3600
# Optional (ADR-0074 sprint T3): the recall (taking the account back from an
# old device after a key reset). Password attempts per anchor, N/SECS
# (default 5/900; chosen, not measured), charged at POST /account/recall/start
# only after the statement by the anchor's key verified; and the recall
# window in whole days (default 30): how long an anchor lives, and how long
# DELETE /account is refused after a change of password or identity key.
# LAKKO_AUTH_LIMIT_RECALL=5/900
# LAKKO_RECALL_WINDOW_DAYS=30
# Optional (ADR-0074 sprint T5): POST /account/keys/rotate/finish per
# signed-in account, N/SECS (default 3/86400; chosen, not measured). Charged
# only after the fresh-auth grant and the supersession proof by the recorded
# identity key were accepted. (Both rotate calls also charge
# LAKKO_AUTH_LIMIT_RECOVERY_REPLACE.)
# LAKKO_AUTH_LIMIT_KEY_ROTATE=3/86400
# Optional (ADR-0073, amended 2026-10-04 and 2026-10-06): lifetime in seconds
# of the fresh-auth grant a PASSWORD or PASSKEY sign-in returns (default 600;
# chosen, not measured). Reset account keys, delete account and add a device
# each require a live one, so a session alone can do none of the three.
# LAKKO_FRESH_GRANT_TTL_SECS=600

# ---- Transparency log append (KT-log S2) ----------------------------------
# The transparency service (services/transparency, :8087) gates its
# POST /transparency/append on a SHARED SERVICE SECRET (not a user bearer).
# The discovery service holds the SAME secret and POSTs a leaf on every
# identity-key CHANGE (best-effort, fail-open — a transparency-side failure
# never fails the discovery upload). Base64, >= 16 bytes after decode. The
# value below is a development placeholder — `openssl rand -base64 32` for a
# production secret. UNSET on the transparency side => the append endpoint
# serves 503; UNSET LAKKO_TRANSPARENCY_URL on the discovery side => the
# append integration is OFF (key changes are not logged).
LAKKO_TRANSPARENCY_APPEND_SECRET=ZGV2LXRyYW5zcGFyZW5jeS1hcHBlbmQtc2VjcmV0LTMyYiE=
# Discovery -> transparency base URL. Unset to turn the append integration
# off entirely (the discovery service logs this once at startup).
LAKKO_TRANSPARENCY_URL=http://127.0.0.1:8087
# KT-log S2.5 — the transparency-log reconciliation-sweep interval (seconds,
# default 300). The discovery reconciler eventually appends every account's
# CURRENT published identity, closing the S2 best-effort fail-open gap.
# Spawned ONLY when LAKKO_TRANSPARENCY_URL is set; 0 disables the sweep.
LAKKO_DISCOVERY_TRANSPARENCY_RECONCILE_SECS=300

# ---- Group wakes: DS -> push-gw internal forward (ADR-0054 decision 1) ------
# A signed group publish carrying `x-lakko-wake: <push_gid>;<kind>` makes the
# DS forward the wake to push-gw's INTERNAL listener (not proxied by nginx),
# authenticated by a shared secret. The two secret variables below MUST hold
# the same value. Base64, >= 16 bytes after decode; the value below is a
# development placeholder — `openssl rand -base64 32` for a real one.
#   * push-gw: secret unset => the internal listener is not started and no
#     group wake is delivered.
#   * DS: URL and secret both unset => headers are validated, wakes dropped
#     (one startup warning); exactly one set => the DS refuses to start.
LAKKO_PUSH_GW_INTERNAL_BIND=127.0.0.1:8092
LAKKO_PUSH_GW_INTERNAL_SECRET=ZGV2LXB1c2gtZ3ctaW50ZXJuYWwtd2FrZS1zZWNyZXQ=
LAKKO_DS_PUSH_GW_URL=http://127.0.0.1:8092
LAKKO_DS_PUSH_GW_SECRET=ZGV2LXB1c2gtZ3ctaW50ZXJuYWwtd2FrZS1zZWNyZXQ=
# Wake cap, per journal and per woken push_gid (defaults 30 / 60 per minute).
# Over the cap the message is still stored; only the wake is dropped.
# LAKKO_DS_WAKE_BURST=30
# LAKKO_DS_WAKE_PER_MINUTE=60

# ---- TOTP authenticator factor (ADR-0018 factor (c)) ---------------------
# Server-static key that encrypts TOTP secrets at rest (base64, EXACTLY 32
# bytes after decode — `openssl rand -base64 32` for production). REQUIRED
# since ADR-0073 (amended 2026-11-26): the authenticator is always offered
# at sign-up and is a key-reset factor, so auth refuses to start without it.
# The dev placeholder below is fine for local testing. This defends a DB-only leak (dump/backup
# theft), not a full-host compromise — the key lives in the service env.
LAKKO_TOTP_ENC_KEY=ZGV2LXRvdHAtZW5jLWtleS0zMi1ieXRlcy1maXhlZCE=

# ---- Owned channels (ADR-0101 section 7) ----------------------------------
# Master of every account's server half of the owned-channels password lock
# (64 hex characters — `openssl rand -hex 32` for production). REQUIRED: auth
# refuses to start without it. The dev placeholder below is fine for local
# testing.
LAKKO_AUTH_OWNED_CHANNELS_SECRET=6c616b6b6f2d6c6f63616c2d6465762d6f776e65642d6368616e6e656c732d73

# ---- Passkey vault (ADR-0072 decision 6) ----------------------------------
# Server-static key that wraps each passkey-vault blob (the phrase entropy a
# client sealed under a passkey's PRF output) at rest (base64, EXACTLY 32
# bytes after decode — `openssl rand -base64 32` for production). OPTIONAL:
# unset disables the /vault/passkey* routes (503); a passkey then still
# signs in and carries no keys. Losing this key in production makes every
# stored blob unreadable; back it up with the DB. The dev placeholder below
# is fine for local testing.
LAKKO_VAULT_ENC_KEY=ZGV2LXZhdWx0LWVuYy1rZXktMzItYnl0ZXMtZml4ZWQh

# ---- Sign in by name (ADR-0054 S5) ----------------------------------------
# Pepper keying the stored login handles (64 hex characters — `openssl rand
# -hex 32` for production). OPTIONAL: unset makes every route that names an
# account by login handle (login, recovery, reset, TOTP) answer
# 503. The dev placeholder below is fine for local testing.
LAKKO_AUTH_HANDLE_PEPPER=6c616b6b6f2d6c6f63616c2d6465762d6c6f67696e2d68616e646c652d706570

# ---- WebAuthn / passkey opt-in (Phase 2a2) --------------------------------
# Three env vars drive the relying-party identity. All three are OPTIONAL —
# leaving them unset disables passkey endpoints (they return 503) while
# keeping the OPAQUE password flow working unchanged.
#
# For local dev with `vite` on port 5173:
LAKKO_WEBAUTHN_RP_ID=localhost
LAKKO_WEBAUTHN_RP_NAME=Lakko (dev)
LAKKO_WEBAUTHN_RP_ORIGIN=http://localhost:5173
# Production:
#   LAKKO_WEBAUTHN_RP_ID=lakko.me
#   LAKKO_WEBAUTHN_RP_NAME=Lakko
#   LAKKO_WEBAUTHN_RP_ORIGIN=https://lakko.me

# ---- Push providers (Phase 1.6b) ------------------------------------------
# Every variable is OPTIONAL. Missing config falls back to LogOnlyProvider
# for that kind (records intent into `tracing` instead of contacting the
# remote service). UnifiedPush has no shared credentials — always wired.
#
# APNs (Apple Push Notification service):
#   LAKKO_APNS_KEY_PATH=./infra/secrets/apns_key.p8
#   LAKKO_APNS_KEY_ID=ABCDE12345
#   LAKKO_APNS_TEAM_ID=1A2B3C4D5E
#   LAKKO_APNS_TOPIC=me.lakko.dev
#   LAKKO_APNS_ENDPOINT=production         # or `sandbox` for TestFlight
#
# FCM (Firebase Cloud Messaging — Android with Google Play Services):
#   LAKKO_FCM_SA_PATH=./infra/secrets/fcm_sa.json
#
# Web Push (RFC 8030/8291/8292):
#   LAKKO_WEBPUSH_VAPID_PRIVATE_KEY_PEM=$(cat infra/secrets/vapid_priv.pem)
#   LAKKO_WEBPUSH_VAPID_PUBLIC_KEY_B64URL=BG...   # base64url-no-pad of the
#                                                  # uncompressed P-256 point
#   LAKKO_WEBPUSH_VAPID_SUBJECT=mailto:admin@lakko.me
#
# Generate a fresh keypair for local dev once via:
#   npx web-push generate-vapid-keys
# The public half goes into apps/web/.env as
# `VITE_LAKKO_WEBPUSH_VAPID_PUBLIC_KEY_B64URL=…` (so the SW
# subscribe orchestrator picks it up at vite build time), and
# both halves go here for `lakko-svc-push-gw` to encrypt outbound
# wakes via RFC 8291.
#
# When the env vars above are unset the push-gw boots in
# log-only mode (no real wakes — see services/push-gw README)
# and apps/web's subscribe orchestrator is a no-op (clients
# fall back to foreground polling). This is the right posture
# for any contributor not actively iterating on push.
