# Workspace-level dev environment.
#
# Copy to `.env` (gitignored):
#   cp .env.example .env
#
# `.env` is loaded:
#   - via `dotenvy::dotenv()` from each service main() in debug builds
#   - RustRover Run Configurations in .run/*.run.xml reference the same
#     keys and pick `.env` up via the EnvFile plugin (if installed) or
#     duplicate the values inline in the Run Config
#
# In production these values are **NOT** used — systemd loads
# /etc/lakko/lakko.env via `EnvironmentFile=` in the service unit files.

# ---- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn,lakko_svc_auth=debug,lakko_svc_ds=debug,lakko_mls=debug

# ---- Database (local docker MariaDB) --------------------------------------
# Each service uses its OWN database. sqlx tracks applied migrations in a
# hardcoded `_sqlx_migrations` table per database, so two services sharing a
# database would see each other's migrations as "missing" and refuse to
# start. One database = one service.
#
# Local docker MariaDB: container `mariadb`, user `lakko/devpass`.
# Create the per-service databases once with the root password (see
# `docker inspect mariadb` for MARIADB_ROOT_PASSWORD):
#
#   docker exec -i mariadb mariadb -u root -p<root_pw> <<'SQL'
#     CREATE DATABASE IF NOT EXISTS lakko_auth
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_ds
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_discovery
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE DATABASE IF NOT EXISTS lakko_push_gw
#       CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL ON lakko_auth.*      TO 'lakko'@'%';
#     GRANT ALL ON lakko_ds.*        TO 'lakko'@'%';
#     GRANT ALL ON lakko_discovery.* TO 'lakko'@'%';
#     GRANT ALL ON lakko_push_gw.*   TO 'lakko'@'%';
#     FLUSH PRIVILEGES;
#   SQL
#
# Each service first reads its dedicated `LAKKO_<NAME>_DATABASE_URL`; if
# unset it falls back to the generic `DATABASE_URL`. The fallback is for
# convenience while running a single service in isolation — in production
# each systemd unit pins its own DB.
LAKKO_AUTH_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_auth
LAKKO_DS_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_ds
LAKKO_DISCOVERY_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_discovery
LAKKO_PUSH_GW_DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_push_gw

# Generic fallback (not used if the per-service var above is set).
DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko_auth

# ---- Service binds (optional — each service has its own default) ----------
# Uncomment to override the listen address.
# LAKKO_BIND=127.0.0.1:8081

# ---- Session tokens (Phase 1.5b) ------------------------------------------
# Shared HMAC-SHA256 secret loaded by BOTH `services/auth` (issues tokens
# on every */finish endpoint) AND `services/discovery` (verifies them on
# every protected write via auth::require_session middleware). The value
# below is a development placeholder — `openssl rand -base64 48` for a
# production secret, drop into /etc/lakko/lakko.env, deploy both services
# together.
LAKKO_SESSION_TOKEN_SECRET=ZGV2LXNlc3Npb24tdG9rZW4tc2VjcmV0LWZvci1sb2NhbC10ZXN0aW5nLW9ubHkhIQ==
# Optional: token TTL in days (default 30). Bump for long-lived dev tokens
# or shorten for a tighter rotation cadence.
# LAKKO_SESSION_TOKEN_TTL_DAYS=30

# ---- TOTP authenticator factor (ADR-0018 factor (c)) ---------------------
# Server-static key that encrypts TOTP secrets at rest (base64, EXACTLY 32
# bytes after decode — `openssl rand -base64 32` for production). OPTIONAL:
# unset disables the /totp/* routes (they return 503). The dev placeholder
# below is fine for local testing. This defends a DB-only leak (dump/backup
# theft), not a full-host compromise — the key lives in the service env.
LAKKO_TOTP_ENC_KEY=ZGV2LXRvdHAtZW5jLWtleS0zMi1ieXRlcy1maXhlZCE=

# ---- Phone / email OTP factor (ADR-0018 factor (d)) ----------------------
# Server-static pepper that KEYS the recovery-contact + OTP-code hashes
# (base64, EXACTLY 32 bytes after decode — `openssl rand -base64 32` for
# production). OPTIONAL: unset disables the /recovery-contact/* routes (they
# return 503). The dev placeholder below is fine for local testing. The phone
# / email PLAINTEXT is NEVER stored or logged (invariant #1) — only a keyed
# hash. Keying on this secret keeps a leaked DB un-enumerable + the hashes
# non-reversible; it defends a DB-only leak, not a full-host compromise.
LAKKO_RECOVERY_CONTACT_PEPPER=ZGV2LXJlY292ZXJ5LWNvbnRhY3QtcGVwcGVyLTMyYiE=
#
# OTP delivery adapters. Both EMAIL and SMS default to a log-only sender in
# dev (the code is written to the auth log, never actually sent), so no real
# credentials are needed for local testing. Set the vars below to arm a real
# adapter (the auth service logs which senders armed at startup).
#
# Email over SMTP (lettre, rustls — no native-tls). All five required to arm;
# any missing one falls back to log-only:
#   LAKKO_SMTP_HOST=smtp.example.com
#   LAKKO_SMTP_PORT=465
#   LAKKO_SMTP_USERNAME=apikey
#   LAKKO_SMTP_PASSWORD=...
#   LAKKO_SMTP_FROM=Lakko <no-reply@lakko.me>
#
# SMS over a Twilio-shaped HTTP API (reqwest, rustls). All four required to
# arm; any missing one falls back to log-only. The API URL embeds the SID:
#   LAKKO_SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts/<SID>/Messages.json
#   LAKKO_SMS_ACCOUNT_SID=AC...
#   LAKKO_SMS_AUTH_TOKEN=...
#   LAKKO_SMS_FROM=+15551234567

# ---- WebAuthn / passkey opt-in (Phase 2a2) --------------------------------
# Three env vars drive the relying-party identity. All three are OPTIONAL —
# leaving them unset disables passkey endpoints (they return 503) while
# keeping the OPAQUE password flow working unchanged.
#
# For local dev with `vite` on port 5173:
LAKKO_WEBAUTHN_RP_ID=localhost
LAKKO_WEBAUTHN_RP_NAME=Lakko (dev)
LAKKO_WEBAUTHN_RP_ORIGIN=http://localhost:5173
# Production:
#   LAKKO_WEBAUTHN_RP_ID=lakko.me
#   LAKKO_WEBAUTHN_RP_NAME=Lakko
#   LAKKO_WEBAUTHN_RP_ORIGIN=https://lakko.me

# ---- Push providers (Phase 1.6b) ------------------------------------------
# Every variable is OPTIONAL. Missing config falls back to LogOnlyProvider
# for that kind (records intent into `tracing` instead of contacting the
# remote service). UnifiedPush has no shared credentials — always wired.
#
# APNs (Apple Push Notification service):
#   LAKKO_APNS_KEY_PATH=./infra/secrets/apns_key.p8
#   LAKKO_APNS_KEY_ID=ABCDE12345
#   LAKKO_APNS_TEAM_ID=1A2B3C4D5E
#   LAKKO_APNS_TOPIC=me.lakko.dev
#   LAKKO_APNS_ENDPOINT=production         # or `sandbox` for TestFlight
#
# FCM (Firebase Cloud Messaging — Android with Google Play Services):
#   LAKKO_FCM_SA_PATH=./infra/secrets/fcm_sa.json
#
# Web Push (RFC 8030/8291/8292):
#   LAKKO_WEBPUSH_VAPID_PRIVATE_KEY_PEM=$(cat infra/secrets/vapid_priv.pem)
#   LAKKO_WEBPUSH_VAPID_PUBLIC_KEY_B64URL=BG...   # base64url-no-pad of the
#                                                  # uncompressed P-256 point
#   LAKKO_WEBPUSH_VAPID_SUBJECT=mailto:admin@lakko.me
#
# Generate a fresh keypair for local dev once via:
#   npx web-push generate-vapid-keys
# The public half goes into apps/web/.env as
# `VITE_LAKKO_WEBPUSH_VAPID_PUBLIC_KEY_B64URL=…` (so the SW
# subscribe orchestrator picks it up at vite build time), and
# both halves go here for `lakko-svc-push-gw` to encrypt outbound
# wakes via RFC 8291.
#
# When the env vars above are unset the push-gw boots in
# log-only mode (no real wakes — see services/push-gw README)
# and apps/web's subscribe orchestrator is a no-op (clients
# fall back to foreground polling). This is the right posture
# for any contributor not actively iterating on push.
