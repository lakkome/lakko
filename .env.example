# Workspace-level dev environment.
#
# Скопируй в `.env` (gitignored):
#   cp .env.example .env
#
# `.env` подхватывается:
#   - через `dotenvy::dotenv()` в каждом service main() (debug-сборка)
#   - RustRover Run Configurations в .run/*.run.xml ссылаются на эти же
#     ключи и подгружают .env через EnvFile plugin (если плагин включён)
#     либо переменные продублированы inline в Run Config
#
# В production эти значения **НЕ** используются — там systemd грузит
# /etc/lakko/lakko.env через EnvironmentFile= в unit-файлах.

# ---- Logging ---------------------------------------------------------------
RUST_LOG=info,sqlx=warn,lakko_svc_auth=debug,lakko_mls=debug

# ---- Database (локальный docker MariaDB) ----------------------------------
# Один общий контейнер `mariadb`, БД `lakko`, юзер `lakko/devpass`.
# См. CLAUDE.md секцию "Local dev" для setup-команд.
DATABASE_URL=mysql://lakko:devpass@127.0.0.1:3306/lakko

# ---- Service binds (опционально — у каждого service есть свой default) ----
# Раскомментировать чтобы переопределить на конкретный port.
# LAKKO_BIND=127.0.0.1:8081

# ---- Push (Phase 1.6+; пока заглушки) -------------------------------------
# APNS_KEY_PATH=./infra/secrets/apns_key.p8
# FCM_SERVICE_ACCOUNT=./infra/secrets/fcm_sa.json
# VAPID_PRIVATE_KEY=./infra/secrets/vapid_priv.pem
